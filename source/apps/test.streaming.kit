# =============================================================================
# test.streaming.kit — 가상 설정 템플릿 (이 파일을 직접 실행하지 않음)
# =============================================================================
#
# 용도:
#   morph.editor + livestream 배포 시 원하는 UI 정책을 담은 **설정 초안**.
#   아래 [package] ~ [template] 구간(또는 파일 전체)을 morph.editor_streaming.kit 에
#   복사·붙여넣기 하여 사용한다.
#
# 목표 정책 (Kit 설정만으로 가능한 범위):
#   - Viewport 위주 (Kit 기본 패널·메뉴 exclude, morph_base_viewer 레이아웃)
#   - 뷰포트 메뉴바·컨텍스트 메뉴 숨김 → orbit/zoom 위주
#   - livestream allowDynamicResize = false
#
# 한계 (본 .kit 만으로는 불가 — Python 확장 쪽 별도 작업 필요):
#   - morph.tbs_control_2 가 띄우는 TBS 제어창·시퀀스 편집기 등
#   - prim 클릭 선택 완전 차단 (manipulator.selection 은 morph.editor 에 포함)
#
# 적용 방법:
#   1) 본 파일 내용 전체를 morph.editor_streaming.kit 에 덮어쓰기
#      (또는 BEGIN GENERATED PART 블록은 morph.editor_streaming.kit 기존 것 유지)
#   2) kit morph.editor_streaming.kit 로 실행
# =============================================================================

[package]
title = "Test Streaming (template — do not run)"
version = "0.1.0"
description = "Viewport-focused streaming layer template for morph.editor_streaming.kit"
keywords = ["experience", "app", "dev", "streaming", "template"]
template_name = "omni.streaming_configuration"

[dependencies]
"morph.editor" = {}  # morph.editor.kit 기반
"omni.kit.livestream.app" = {}
"omni.kit.quicklayout" = { order = 900 }
"morph.morph_base_viewer" = { order = 1000 }  # Viewport 전용 레이아웃·메뉴바 숨김

[settings.app]
fastShutdown = true
name = "Morph Editor Streaming"
renderer.resolution.height = 1080
renderer.resolution.width = 1920
window.height = 1080
window.width = 1920
window.showStatusBar = false

[settings.app.morph]
streamingUi = true  # morph.tbs_control_2 streaming 배포 감지용 (기존 코드)

[settings.exts."omni.kit.livestream.app".primaryStream]
allowDynamicResize = false

[settings.persistent.app]
viewport.autoFrame.mode = "first_open"
viewport.noPadding = true

[settings]
rtx.post.aa.op = 3
rtx.verifyDriverVersion.enabled = false
exts."omni.kit.viewport.window".windowMenu.entryCount = 1
exts."omni.kit.viewport.window".windowMenu.label = ""
exts."omni.kit.window.viewport".showContextMenu = false

[settings.persistent.exts."omni.kit.viewport.menubar.lighting"]
visible = false

[settings.persistent.exts."omni.kit.viewport.menubar.render"]
visible = false

[settings.persistent.exts."omni.kit.viewport.menubar.display"]
visible = false

[settings.persistent.exts."omni.kit.viewport.menubar.camera"]
visible = false

[settings.persistent.exts."omni.kit.viewport.menubar.settings"]
visible = false

[settings.app.viewport.defaults]
fillViewport = true
guide.grid.visible = false
guide.axis.visible = false
hud.visible = false
scene.cameras.visible = false
scene.lights.visible = false

[settings.app.viewport.defaults.hud]
deviceMemory.visible = false
hostMemory.visible = false
renderFPS.visible = false
renderProgress.visible = false
renderResolution.visible = false

[settings.app.extensions]
registryEnabled = true
supportedTargets.platform = []

exclude = [
    "omni.kit.developer.bundle",
    "omni.kit.widget.cache_indicator",
    "omni.kit.window.console",
    "omni.kit.window.content_browser",
    "omni.kit.window.stage",
    "omni.kit.window.status_bar",
    "omni.kit.window.toolbar",
    "omni.kit.window.property",
    "omni.kit.menu.file",
    "omni.kit.menu.edit",
    "omni.kit.menu.create",
    "omni.kit.menu.common",
]

[settings.app.exts]
folders.'++' = [
    "${root}/source/extensions",
    "${app}/../exts",
    "${app}/../apps",
    "${app}/../extscache"
]

[settings.app.file]
ignoreUnsavedOnExit = true

[template]
type = "ApplicationLayerTemplate"

# --- 아래 BEGIN GENERATED PART 는 morph.editor_streaming.kit 의 동일 블록을 그대로 유지 ---

